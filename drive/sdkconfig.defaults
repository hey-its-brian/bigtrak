# bigtrak drive board. Based on esp-idf-arduino-bluepad32-template.
# Delete the generated sdkconfig.drive after changing anything here, or the
# old values win.

#
# ESP32
#
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_XTAL_FREQ_AUTO=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

#
# Bluetooth: BTstack drives the controller directly (no Bluedroid)
#
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
# Must be at least one more than CONFIG_BLUEPAD32_MAX_DEVICES
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=3
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000

#
# Bluepad32
#
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
# Only one pad drives the tank. A second slot lets a new pad connect so the
# firmware can turn it away politely instead of the stack refusing it.
CONFIG_BLUEPAD32_MAX_DEVICES=2
# The Bluepad32 console grabs the USB UART. We want Arduino Serial instead,
# for debug commands and for typing protocol lines from the Mac.
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n
CONFIG_BLUEPAD32_ENABLE_VIRTUAL_DEVICE_BY_DEFAULT=n

#
# Arduino
#
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_BLE=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n

#
# BTstack
#
CONFIG_BTSTACK_AUDIO=n
